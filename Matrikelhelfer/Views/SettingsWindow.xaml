<mah:MetroWindow x:Class="Matrikelhelfer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Einstellungen" Height="620" Width="700"
        Topmost="True" WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        ShowMinButton="False" ShowMaxRestoreButton="False">
    <mah:MetroWindow.Resources>
        <!-- Bind Name explicitly (not ToString) so a list entry renames
             live while the user types. Shared by both format lists. -->
        <DataTemplate x:Key="FormatNameTemplate">
            <TextBlock Text="{Binding Name}" Padding="2,4" />
        </DataTemplate>
        <!-- Same accent-themed section-heading look as MainWindow. -->
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- Small muted caption above each editor field, matching the
             floating-watermark look of the main window's CopyableFields. -->
        <Style x:Key="FieldCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <!-- Placeholder "chips": accent-tinted rounded pills that fill with
             the full accent color on hover. Focusable=False keeps the
             template TextBox's focus and caret alive while clicking, so the
             token can be inserted at the caret position. -->
        <Style x:Key="PlaceholderChipStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Padding="9,3"
                                Background="{DynamicResource MahApps.Brushes.Accent4}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource MahApps.Brushes.Accent}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: the target switcher (which field the formats render
                 into - source or citation, maybe more later) above that
                 target's format list plus add/delete. The list's selected
                 entry is the ACTIVE format applied to the target's field
                 after OK; each target remembers its own selection while
                 switching. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ComboBox Grid.Row="0" Margin="0,0,0,6"
                          ItemsSource="{Binding Targets}"
                          SelectedItem="{Binding SelectedTarget}"
                          DisplayMemberPath="DisplayName" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding SelectedTarget.Formats}"
                         SelectedItem="{Binding SelectedTarget.Selected}"
                         ItemTemplate="{StaticResource FormatNameTemplate}" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Width="30" Height="30" Padding="0"
                            Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                            ToolTip="Neues Format hinzufügen"
                            Command="{Binding AddCommand}">
                        <iconPacks:PackIconFontAwesome6 Kind="PlusSolid" Width="14" Height="14" />
                    </Button>
                    <Button Width="30" Height="30" Padding="0" Margin="4,0,0,0"
                            Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                            ToolTip="Ausgewähltes Format löschen"
                            Command="{Binding DeleteCommand}">
                        <iconPacks:PackIconFontAwesome6 Kind="TrashSolid" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Right: the editor for the visible list's selected format. -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Name" Style="{StaticResource FieldCaptionStyle}" />
                <TextBox Margin="0,0,0,10"
                         Text="{Binding SelectedTarget.Selected.Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Formatvorlage" Style="{StaticResource FieldCaptionStyle}" />
                <TextBox x:Name="TemplateBox" Height="90" Margin="0,0,0,10"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                         Text="{Binding SelectedTarget.Selected.Template, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Platzhalter (zum Einfügen klicken)" Style="{StaticResource FieldCaptionStyle}" />
                <!-- Outer control = one WrapPanel row per topic group
                     (place / book / page / links+date); a group only wraps
                     within its own row when the window is narrow. -->
                <ItemsControl Margin="0,0,0,10" ItemsSource="{Binding PlaceholderGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Content stays the bare name string so the
                                             click handler's Content-pattern keeps
                                             working; the description only tooltips. -->
                                        <Button Content="{Binding Name}"
                                                ToolTip="{Binding Description}"
                                                Style="{StaticResource PlaceholderChipStyle}"
                                                Click="Placeholder_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Datumsformat (für Von, Bis, AccessDate)" Style="{StaticResource FieldCaptionStyle}" />
                <ComboBox Margin="0,0,0,10" HorizontalAlignment="Left" MinWidth="230"
                          ItemsSource="{Binding DateStyles}"
                          DisplayMemberPath="Sample"
                          SelectedItem="{Binding SelectedTarget.Selected.DateStyle}" />

                <TextBlock Text="Vorschau (mit Beispielwerten)" Style="{StaticResource FieldCaptionStyle}" />
                <Border BorderThickness="1" CornerRadius="3" Padding="8"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                        Background="{DynamicResource MahApps.Brushes.Gray10}">
                    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="16,4" Content="OK" IsDefault="True" Click="Ok_Click" />
            <Button Padding="16,4" Margin="8,0,0,0" Content="Abbrechen" IsCancel="True" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
