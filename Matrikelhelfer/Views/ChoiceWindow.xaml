<mah:MetroWindow x:Class="Matrikelhelfer.Views.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        Topmost="True" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        TitleCharacterCasing="Normal"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        ShowMinButton="False" ShowMaxRestoreButton="False">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <iconPacks:PackIconFontAwesome6 Kind="CircleQuestionSolid" Width="22" Height="22"
                                            VerticalAlignment="Top" Margin="0,2,14,0"
                                            Foreground="{DynamicResource MahApps.Brushes.Accent}" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Width="400" />
        </StackPanel>

        <!-- Each choice is its own labelled button: the two real actions read
             as what they do, instead of being smuggled into OK/Cancel. -->
        <StackPanel Grid.Row="1" Margin="0,20,0,0"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="PrimaryButton" Padding="16,4" IsDefault="True" Click="Primary_Click"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    Foreground="{DynamicResource MahApps.Brushes.IdealForeground}" />
            <Button x:Name="SecondaryButton" Padding="16,4" Margin="8,0,0,0" Click="Secondary_Click" />
            <Button Content="Abbrechen" Padding="16,4" Margin="8,0,0,0"
                    IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
