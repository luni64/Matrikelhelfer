<mah:MetroWindow x:Class="Matrikelhelfer.Views.EventTypeDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Ereignis vormerken"
        Width="380" Height="560" MinWidth="320" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Label Content="Datum des Ereignisses:" Padding="0,0,0,2" />
            <DockPanel Margin="0,0,0,6">
                <ComboBox x:Name="DateModifierBox" DockPanel.Dock="Left"
                          Width="80" Margin="0,0,6,0"
                          ToolTip="Datumsqualifizierer (wie in Gramps): genau / um / vor / nach" />
                <TextBox x:Name="DateBox" VerticalContentAlignment="Center"
                         ToolTip="jjjj, jjjj-mm oder jjjj-mm-tt — leer = ohne Datum. Bei Erwähnungen (»Mutter bereits verstorben«) eigenes Datum eintragen, z. B. »vor 1757«." />
            </DockPanel>
            <Label Content="Ort (optional):" Padding="0,0,0,2" />
            <TextBox x:Name="PlaceBox" VerticalContentAlignment="Center"
                     Margin="0,0,0,6"
                     ToolTip="Ort des Ereignisses. Beim Upload wird ein vorhandener Gramps-Ort mit diesem Namen wiederverwendet, sonst neu angelegt." />
            <Label Content="Beschreibung (optional):" Padding="0,0,0,2" />
            <TextBox x:Name="DescriptionBox" VerticalContentAlignment="Center"
                     Margin="0,0,0,8"
                     ToolTip="Entspricht dem Feld „Beschreibung“ des Gramps-Ereignisses: eine einzeilige Kurzbeschreibung, KEINE Notiz. Die Notiz am Zitat kommt aus dem Notiz-Feld des Funds." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Vormerken" IsDefault="True"
                        IsEnabled="False" Padding="14,4" Margin="0,0,8,0"
                        Click="Save_Click" />
                <Button Content="Abbrechen" IsCancel="True" Padding="14,4" />
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="TypeList" DisplayMemberPath="Label"
                 SelectionChanged="TypeList_SelectionChanged"
                 MouseDoubleClick="TypeList_MouseDoubleClick"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                       Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                       Margin="2,6,0,2" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>
    </DockPanel>
</mah:MetroWindow>
