<mah:MetroWindow x:Class="Matrikelhelfer.Views.BrowserPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Mit Browser verbinden" Height="320" Width="440"
        Topmost="True" WindowStartupLocation="CenterOwner"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        ShowMinButton="False" ShowMaxRestoreButton="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Wählen Sie einen Browser zum Verbinden aus. Nach dem Verbinden liest diese App die dort angezeigte Kirchenbuch-Seite, sobald Sie auf die Schaltfläche „Lesen“ klicken. Sie können die Verbindung jederzeit wieder trennen." />

        <ListBox x:Name="BrowserList" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="16,4" Content="Verbinden" IsDefault="True" Click="Connect_Click" />
            <Button Padding="16,4" Margin="8,0,0,0" Content="Abbrechen" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
