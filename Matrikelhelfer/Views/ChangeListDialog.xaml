<mah:MetroWindow x:Class="Matrikelhelfer.Views.ChangeListDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:Matrikelhelfer.ViewModels"
        Title="Änderungsliste"
        Width="560" Height="480" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <!-- The change list moved out of the Gramps tab's cramped 500px
         column (2026-08): the tab keeps only a summary row, this dialog
         has the space to show every entry in full. DataContext = the
         GrampsViewModel, so the tree, the cascade deletes and the send
         command are the SAME objects the tab uses - the dialog stays
         live while entries change (e.g. after sending from here). -->
    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </mah:MetroWindow.Resources>
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Schließen" IsCancel="True"
                    Padding="14,4" />
            <Button DockPanel.Dock="Right" Content="An Gramps senden"
                    FontWeight="SemiBold" Padding="14,4" Margin="0,0,8,0"
                    Command="{Binding SendCommand}"
                    ToolTip="Alle Änderungen in EINER Gramps-Transaktion ausführen (ein Undo in Gramps macht alles rückgängig)" />
            <TextBlock Text="Alle Änderungen werden in einer Gramps-Transaktion ausgeführt — ein Undo verwirft alles."
                       FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                       Margin="0,0,8,0" />
        </DockPanel>
        <TreeView ItemsSource="{Binding ChangeTree}" BorderThickness="0"
                  Background="Transparent"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem"
                       BasedOn="{StaticResource MahApps.Styles.TreeViewItem}">
                    <Setter Property="IsExpanded" Value="True" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type vm:GrampsChangeGroupVM}"
                                          ItemsSource="{Binding Children}">
                    <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Padding="3,0"
                                Margin="6,0,0,0"
                                Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                                ToolTip="Alle Änderungen zu dieser Person/Familie entfernen"
                                Command="{Binding DataContext.DeleteGroupCommand,
                                          RelativeSource={RelativeSource AncestorType=TreeView}}"
                                CommandParameter="{Binding}">
                            <iconPacks:PackIconFontAwesome6 Kind="TrashCanSolid"
                                    Width="11" Height="11" Foreground="Firebrick" />
                        </Button>
                        <TextBlock Text="{Binding EntityLabel}" FontWeight="Bold"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </HierarchicalDataTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:GrampsChangeNodeVM}"
                                          ItemsSource="{Binding Children}">
                    <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Padding="3,0"
                                Margin="6,0,0,0"
                                Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                                ToolTip="Diese Änderung entfernen (abhängige werden mit entfernt)"
                                Command="{Binding DataContext.DeleteEntryCommand,
                                          RelativeSource={RelativeSource AncestorType=TreeView}}"
                                CommandParameter="{Binding Entry}">
                            <iconPacks:PackIconFontAwesome6 Kind="TrashCanSolid"
                                    Width="10" Height="10" Foreground="Firebrick" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="{Binding Entry.DisplayText}"
                                       TextWrapping="Wrap" FontSize="12" />
                            <TextBlock Text="{Binding Entry.Error}" Foreground="Firebrick"
                                       FontSize="11" TextWrapping="Wrap"
                                       Visibility="{Binding Entry.HasError,
                                                    Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</mah:MetroWindow>
