<mah:MetroWindow x:Class="Matrikelhelfer.Views.CitationEditDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Zitat bearbeiten"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <StackPanel Margin="12">
        <TextBlock x:Name="ContextLine" FontWeight="SemiBold" Margin="0,0,0,8"
                   TextWrapping="Wrap" />
        <Label x:Name="SeiteLabel" Content="Seite (handschriftliche Nummer):"
               Padding="0,0,0,2" />
        <TextBox x:Name="SeiteBox" VerticalContentAlignment="Center"
                 Margin="0,0,0,6"
                 ToolTip="Die echte handschriftliche Seitennummer — sie kann nicht ausgelesen werden. Leer = Seite unbekannt." />
        <Label x:Name="NoteLabel" Content="Notiz:" Padding="0,0,0,2" />
        <TextBox x:Name="CommentBox" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="60" MaxHeight="140"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                 ToolTip="Wird beim Upload zur Notiz am Gramps-Zitat (wie das Feld „Notiz“ im Gramps-Zitateditor)." />
        <DockPanel>
            <!-- copy = a SECOND citation of the same page with its own
                 comment (e.g. a different note for another person); the
                 original find keeps its comment, a corrected Seite reaches
                 both (page fact). -->
            <Button x:Name="CopyButton" DockPanel.Dock="Left"
                    Content="Als Kopie speichern" Padding="14,4"
                    ToolTip="Legt einen neuen Fund auf derselben Seite mit dieser Notiz an — der bestehende Fund bleibt unverändert."
                    Click="SaveAsCopy_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Übernehmen" IsDefault="True" Padding="14,4"
                        Margin="0,0,8,0" Click="Save_Click" />
                <Button Content="Abbrechen" IsCancel="True" Padding="14,4" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</mah:MetroWindow>
