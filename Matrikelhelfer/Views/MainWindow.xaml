<mah:MetroWindow x:Class="Matrikelhelfer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:views="clr-namespace:Matrikelhelfer.Views"
        Title="Matrikelhelfer" Height="800" Width="550"
        Icon="pack://application:,,,/Assets/Matrikelhelfer.ico"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <mah:MetroWindow.Resources>
        <!-- Shared section-heading look: sourced entirely from MahApps theme
             resources (DynamicResource) rather than hardcoded colors/fonts, so
             a future accent/theme change re-colors every heading automatically. -->
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
            <!-- MahApps.Fonts.Family.Header is "Segoe UI Light, ..." - a family
                 string that pins a specific Light-weight face, so a FontWeight
                 setter on top of it is largely ignored by WPF's font-face
                 resolution. Family.Control is weight-neutral, so SemiBold
                 actually renders bold. -->
            <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Groups a section (heading + its fields) into a subtle rounded
             "card" so the flat field-list reads as distinct groups. Same
             theme-managed Gray10 surface as the saved-entries panel, so the
             tint survives light/dark/accent changes. -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray9}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <views:CitationPreviewConverter x:Key="CitationPreviewConverter" />
        <!-- Shared item template for the format dropdowns: [format name /
             rendered preview]. WPF's SelectionBoxItemTemplate behavior makes
             the closed box show the same, so the field always displays the
             actual rendered text. Without an explicit width, a wrapping
             TextBlock doesn't wrap until it runs out of room to grow into,
             so the whole dropdown would balloon to fit the unwrapped text -
             binding to the ComboBox's own ActualWidth keeps every item (and
             the popup itself) the same width as the closed box. -->
        <DataTemplate x:Key="FormatPreviewTemplate">
            <StackPanel Margin="2"
                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                <!-- "Quelle (German - short)" instead of the bare format
                     name: the name alone doesn't tell WHICH of the two
                     dropdowns this is. The kind prefix comes from the
                     ComboBox's Tag so the template stays shared. -->
                <TextBlock Foreground="Gray" FontSize="11" Margin="0,0,0,4">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} ({1})">
                            <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=ComboBox}" />
                            <Binding Path="Name" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource CitationPreviewConverter}">
                            <Binding Path="." />
                            <Binding Path="DataContext.DisplayedInfo"
                                     RelativeSource="{RelativeSource AncestorType=ComboBox}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <!-- Strips the default ComboBoxItem chrome so the custom content
             isn't fighting a selection-highlight rectangle. -->
        <Style x:Key="FormatComboItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <!-- Settings lives in the title bar (MahApps window commands) - it is
         app-level configuration, not part of the citation workflow row. -->
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <Button Command="{Binding HelpCommand}" ToolTip="Handbuch öffnen">
                <iconPacks:PackIconFontAwesome6 Width="14" Height="14" Kind="CircleQuestionSolid" />
            </Button>
            <Button Command="{Binding OpenSettingsCommand}" ToolTip="Einstellungen">
                <iconPacks:PackIconFontAwesome6 Width="14" Height="14" Kind="GearSolid" />
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>
    <!-- Root: main content plus a DOCKED saved-entries panel (replaces the
         earlier overlay Flyout, which hid the fields while open). The panel
         column is 0-width while closed; the list button toggles it to a
         fixed width and widens the WINDOW by the same amount (code-behind,
         UpdateEntriesPanel), so the fields keep their size and both are
         visible side by side. -->
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- One-line status bar across the whole window (fields AND
                 panel) - long texts get an ellipsis, the tooltip has the
                 full message. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ContentColumn" Width="*" />
            <ColumnDefinition x:Name="EntriesColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{DynamicResource MahApps.Brushes.Gray10}"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                BorderThickness="0,1,0,0" Padding="15,4">
            <DockPanel>
                <!-- Compact permanent Gramps indicator on the right: plug
                     color = connection state, short text = tree name, full
                     status in the tooltip. Clicking toggles the connection
                     (the tab also auto-connects when opened). Lives here
                     instead of a card in the Gramps tab - the app must stay
                     small enough to sit beside the browser. -->
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="2,0"
                        Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                        Command="{Binding ToggleGrampsConnectionCommand}"
                        ToolTip="{Binding GrampsStatusText}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome6 Kind="PlugSolid" Width="11" Height="11"
                                                        VerticalAlignment="Center">
                            <iconPacks:PackIconFontAwesome6.Style>
                                <Style TargetType="iconPacks:PackIconFontAwesome6">
                                    <Setter Property="Foreground" Value="Orange" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGrampsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="Green" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconFontAwesome6.Style>
                        </iconPacks:PackIconFontAwesome6>
                        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding GrampsShortStatus}"
                                   Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                    </StackPanel>
                </Button>
                <!-- NEUTRAL color: the bar mostly carries informational
                     messages ("3 Änderungen offen", "Zitat aktualisiert");
                     severe failures additionally raise an error DIALOG,
                     so red-for-everything signalled nothing (2026-08). -->
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="{Binding StatusText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusText}" Value="">
                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Saved finds - a flat, sortable DataGrid for now (the
             Land/Bistum/Pfarrei/Buch tree comes later). Single click
             redisplays an entry in the main fields, double-click
             additionally drives the browser back to its scan, Entf/context
             menu deletes. Default sort: newest first. Gray10 is MahApps'
             subtlest neutral surface brush - theme-managed, so the "card"
             tint survives light/dark/accent changes. -->
        <Grid x:Name="EntriesPanel" Grid.Column="1" Margin="0,15,15,15" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Spacer mirroring the left side's vertical structure (button
                 row + its 8 margin + tab-header strip + the tab content's 8
                 top margin), so the tray card's top edge lines up with the
                 Notizen card - bound to the REAL element heights, no magic
                 pixel constants. A TabItem element IS its header chip, so
                 its ActualHeight is exactly the header-strip height. -->
            <StackPanel Grid.Row="0" IsHitTestVisible="False">
                <Border Height="{Binding ActualHeight, ElementName=TopButtonRow}" />
                <Border Height="8" />
                <Border Height="{Binding ActualHeight, ElementName=ZitateTabItem}" />
                <Border Height="8" />
            </StackPanel>

            <!-- Tray card: same look as the left-hand section cards, but
                 filling the whole remaining height - the card list scrolls
                 inside, the export/clear band sits at the card bottom. -->
            <Border Grid.Row="1"
                    Background="{DynamicResource MahApps.Brushes.Gray9}"
                    CornerRadius="6" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Ablage"
                           Style="{StaticResource SectionHeadingStyle}" />
                <!-- Bottom band: exports left, guarded bulk delete right.
                     Must precede the fill ListBox so it docks below it. -->
                <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Left" Margin="0,0,10,0"
                            Command="{Binding ExportBibTexCommand}"
                            Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                            ToolTip="Als BibTeX-Bibliothek (.bib) exportieren">
                        <iconPacks:PackIconFontAwesome6 Kind="AtSolid" Width="15" Height="15" />
                    </Button>
                    <Button DockPanel.Dock="Left"
                            Command="{Binding ExportEntriesCommand}"
                            Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                            ToolTip="Einträge als CSV exportieren">
                        <iconPacks:PackIconFontAwesome6 Kind="FileExportSolid" Width="15" Height="15" />
                    </Button>
                    <Button DockPanel.Dock="Right"
                            Command="{Binding ClearAllEntriesCommand}"
                            Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                            ToolTip="Alle gespeicherten Einträge löschen">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconFontAwesome6 Kind="TrashCanSolid" Width="12" Height="12"
                                                            VerticalAlignment="Center" Foreground="Firebrick" />
                            <TextBlock Text="Alle löschen" Margin="6,0,0,0"
                                       VerticalAlignment="Center" Foreground="Firebrick" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            <!-- The tray: saved finds as CARDS (the same visual unit the
                 Gramps tab will use as source-citation cards). Replaces the
                 earlier DataGrid: with the short-term-storage model there is
                 nothing to sort by columns - newest first, fixed. Single
                 click redisplays (Zitate tab), double-click drives the
                 browser to the scan, x deletes without selecting. -->
            <ListBox x:Name="EntriesList"
                     Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding SavedEntries}"
                     SelectedItem="{Binding SelectedSavedEntry, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     MouseDoubleClick="EntriesList_MouseDoubleClick"
                     PreviewMouseRightButtonDown="EntriesList_PreviewMouseRightButtonDown"
                     PreviewMouseLeftButtonDown="EntriesList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="EntriesList_PreviewMouseMove">
                <ListBox.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteEntryCommand}" />
                </ListBox.InputBindings>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Im Browser öffnen" Command="{Binding NavigateToEntryCommand}" />
                        <MenuItem Header="Zitat bearbeiten…" Command="{Binding EditCitationCommand}" />
                        <MenuItem Header="In Gramps-Ansicht übernehmen" Command="{Binding AdoptIntoGrampsCommand}" />
                        <MenuItem Header="Eintrag löschen" Command="{Binding DeleteEntryCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <!-- Card chrome lives on the CONTAINER so selection can
                         restyle the border; the comment stays a tooltip (too
                         long for the card). Chrome matches the Gramps tab's
                         source cards (Gray6/1.3, radius 6, padding 8,5;
                         selection = accent border 2.2) so a find looks the
                         same in both lists. -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="ToolTip" Value="{Binding Comment}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card"
                                            Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                            BorderBrush="{DynamicResource MahApps.Brushes.Gray6}"
                                            BorderThickness="1.3" CornerRadius="6"
                                            Padding="8,5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush"
                                                    Value="{DynamicResource MahApps.Brushes.Gray5}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush"
                                                    Value="{DynamicResource MahApps.Brushes.Accent}" />
                                            <Setter TargetName="Card" Property="BorderThickness"
                                                    Value="2.2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Comment}" Value="">
                                <Setter Property="ToolTip" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <!-- Content = the SHARED card face (SavedEntry.Card*):
                         the same three lines the Gramps tab's finding cards
                         show, plus the comment's first line on top (two
                         finds on one page differ only by their comments).
                         The saved date moved out of the card with the
                         redesign (the list is date-sorted anyway). -->
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <!-- lead line = first line of the comment:
                                     with Name gone it is what tells two
                                     finds on one page apart -->
                                <TextBlock x:Name="NoteLine" Text="{Binding CardNote}"
                                           FontWeight="SemiBold" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CardTitle}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SubtitleLine" Text="{Binding CardSubtitle}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PageLine" Text="{Binding CardPage}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <!-- both buttons appear only while their card is
                                 hovered (Hidden keeps the layout stable) and
                                 act on THIS card via CommandParameter, no
                                 selection needed. -->
                            <StackPanel Grid.Column="1" Orientation="Vertical"
                                        VerticalAlignment="Top" Margin="6,0,0,0">
                                <Button CommandParameter="{Binding}"
                                        Command="{Binding DataContext.EditCitationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        Width="20" Height="20" Padding="0"
                                        ToolTip="Zitat bearbeiten (Seite und Notiz)">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Chromeless}">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True"
                                                             Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <iconPacks:PackIconFontAwesome6 Kind="PencilSolid" Width="10" Height="10"
                                                                    Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                                </Button>
                                <Button CommandParameter="{Binding}"
                                        Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        Width="20" Height="20" Padding="0"
                                        ToolTip="Eintrag löschen">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Chromeless}">
                                            <Setter Property="Visibility" Value="Hidden" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True"
                                                             Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <iconPacks:PackIconFontAwesome6 Kind="XmarkSolid" Width="12" Height="12"
                                                                    Foreground="Firebrick" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <!-- empty lines collapse, exactly like on the
                                 Gramps tab's source cards -->
                            <DataTrigger Binding="{Binding CardNote}" Value="">
                                <Setter TargetName="NoteLine" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CardSubtitle}" Value="">
                                <Setter TargetName="SubtitleLine" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CardPage}" Value="">
                                <Setter TargetName="PageLine" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>
            </Border>
        </Grid>

        <!-- Symmetric 15 margin; while the panel is open its right half
             doubles as the gap to the tray (the tray has no left margin). -->
        <Grid x:Name="ContentGrid" Grid.Column="0" Margin="15" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Workflow buttons: connect on the left; the work verbs on the
             right - Lesen, Speichern, list toggle - so read and save sit
             next to each other. Named so the tray spacer can mirror this
             row's height (see EntriesPanel). -->
        <StackPanel x:Name="TopButtonRow" Orientation="Horizontal"
                    HorizontalAlignment="Left" Margin="0,0,0,8">
            <Button Style="{DynamicResource MahApps.Styles.Button.Circle}"
                Width="40" Height="40" Padding="0"
                Command="{Binding ToggleConnectionCommand}"
                ToolTip="{Binding ConnectionStatusText}">
                <iconPacks:PackIconFontAwesome6 Width="25" Height="25" Kind="PlugSolid">
                    <iconPacks:PackIconFontAwesome6.Style>
                        <Style TargetType="iconPacks:PackIconFontAwesome6">
                            <Setter Property="Foreground" Value="Orange" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Foreground" Value="Green" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </iconPacks:PackIconFontAwesome6.Style>
                </iconPacks:PackIconFontAwesome6>
            </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <!-- Lesen is the primary action - filled accent so it stands
                 out from the neutral circle buttons around it. -->
            <Button Style="{DynamicResource MahApps.Styles.Button.Circle}"
                Width="40" Height="40" Padding="0" Margin="0,0,8,0"
                Background="{DynamicResource MahApps.Brushes.Accent}"
                Foreground="White"
                Command="{Binding ReadCommand}"
                ToolTip="Kirchenbuch-Seite aus dem Browser lesen">
                <iconPacks:PackIconFontAwesome6 Width="22" Height="22" Kind="BookOpenReaderSolid"
                                                Foreground="White" />
            </Button>
            <Button Style="{DynamicResource MahApps.Styles.Button.Circle}"
                Width="40" Height="40" Padding="0" Margin="0,0,8,0"
                Command="{Binding SaveCommand}"
                ToolTip="Eintrag speichern">
                <iconPacks:PackIconFontAwesome6 Width="22" Height="22" Kind="FloppyDiskSolid" />
            </Button>
            <Button Style="{DynamicResource MahApps.Styles.Button.Circle}"
                Width="40" Height="40" Padding="0"
                Command="{Binding ToggleEntriesPanelCommand}"
                ToolTip="Ablage anzeigen (gespeicherte Funde)">
                <iconPacks:PackIconFontAwesome6 Width="22" Height="22" Kind="ListSolid" />
            </Button>
        </StackPanel>

        <!-- Two work modes, one window: "Zitate" is the classic copy/paste
             citation view, "Gramps" will host the Gramps-Modus (walkable
             tree + assignment view; connection follows in the next stage).
             The saved-finds tray to the right sits OUTSIDE the tabs and
             serves both. -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    mah:TabControlHelper.Underlined="SelectedTabItem">
        <TabItem x:Name="ZitateTabItem" Header="Zitate"
                 mah:HeaderedControlHelper.HeaderFontSize="16">
        <!-- Right padding is added ONLY while the scrollbar is actually
             visible (trigger below), giving the cards a small gap to the
             scrollbar. With no scrollbar the padding is 0, so the left/right
             gaps stay symmetric (the button row above has no scrollbar inset
             to match a constant padding). -->
        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Padding" Value="0" />
                    <Style.Triggers>
                        <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                            <Setter Property="Padding" Value="0,0,8,0" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
        <StackPanel>
            <!-- The find's annotation, saved together with the entry so
                 interesting finds can be revisited later: the free-text
                 Notiz (named after the Gramps field it becomes - the note
                 on the uploaded citation), cleared on every read. The
                 former Name field was removed (2026-08) - it never reached
                 Gramps; whose record it is belongs in the note. -->
            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="Notizen" Style="{StaticResource SectionHeadingStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconFontAwesome6 Grid.Column="0" Kind="CommentSolid"
                                Width="15" Height="15" VerticalAlignment="Top" Margin="2,8,8,0"
                                Foreground="{DynamicResource MahApps.Brushes.Gray3}" />
                        <TextBox Grid.Column="1" Padding="6,5" Height="60"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 mah:TextBoxHelper.Watermark="Notiz"
                                 ToolTip="Wird beim Gramps-Upload zur Notiz am Zitat (Gramps-Feld „Notiz“); die erste Zeile ist die Überschrift der Ablage-Karte."
                                 mah:TextBoxHelper.UseFloatingWatermark="True"
                                 Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="Quelle" Style="{StaticResource SectionHeadingStyle}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Bistum uses an archive icon: the archive is the
                             actual place the books are held (Bistum is to be
                             renamed to Archiv later). -->
                        <views:CopyableField Grid.Column="0" Margin="0,0,10,0" Label="Bistum"
                                             IconKind="BoxArchiveSolid" Value="{Binding BistumText}" />
                        <views:CopyableField Grid.Column="1" Margin="10,0,0,0" Label="Pfarrei"
                                             IconKind="ChurchSolid" Value="{Binding ParishText}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <views:CopyableField Grid.Column="0" Margin="0,0,10,0" Label="Buchtyp"
                                             IconKind="BookSolid" Value="{Binding BookText}" />
                        <views:CopyableField Grid.Column="1" Margin="10,0,0,0" Label="Signatur"
                                             IconKind="BarcodeSolid" Value="{Binding SignatureText}" />
                    </Grid>

                    <!-- The rendered source line for pasting into the
                         genealogy software's source (book) record - dropdown
                         switches between the user-defined source formats,
                         each entry previewing its rendering of the current
                         record. -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 25px left indent = the field icon column width
                             (2 + 15 icon + 8), so the dropdown's left edge
                             lines up with the icon-fields above it even
                             though the dropdown itself has no icon. -->
                        <ComboBox Grid.Column="0" Margin="25,0,6,0" Tag="Quelle"
                                  ItemsSource="{Binding SourceFormats}"
                                  SelectedItem="{Binding SelectedSourceFormat}"
                                  ItemTemplate="{StaticResource FormatPreviewTemplate}"
                                  ItemContainerStyle="{StaticResource FormatComboItemStyle}" />
                        <Button Grid.Column="1" Width="30" Height="30" Padding="0"
                                VerticalAlignment="Top"
                                Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                                ToolTip="Quellenangabe in die Zwischenablage kopieren"
                                Command="{Binding CopySourceCommand}">
                            <iconPacks:PackIconFontAwesome6 Kind="CopySolid" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="Zitat" Style="{StaticResource SectionHeadingStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Seite is editable and starts empty on every read
                             (the number parsed from the scan label rarely
                             matches the real handwritten page number - no
                             guessing); red border while still empty. -->
                        <views:CopyableField Grid.Column="0" Margin="0,0,10,0" Label="Seite"
                                             IconKind="FileLinesSolid"
                                             IsValueReadOnly="False" WarnWhenEmpty="True"
                                             Value="{Binding PageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <views:CopyableField Grid.Column="1" Margin="10,0,0,0" Label="Scan-ID"
                                             IconKind="AddressCardSolid" Value="{Binding PageIdText}" />
                    </Grid>

                    <!-- The rendered per-page citation line for pasting into
                         the genealogy software's citation on the source above
                         - dropdown switches between the user-defined citation
                         formats. -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Left indent matches the icon-field column above
                             (see the Quelle dropdown). -->
                        <ComboBox Grid.Column="0" Margin="25,0,6,0" Tag="Zitat"
                                  ItemsSource="{Binding CitationFormats}"
                                  SelectedItem="{Binding SelectedCitationFormat}"
                                  ItemTemplate="{StaticResource FormatPreviewTemplate}"
                                  ItemContainerStyle="{StaticResource FormatComboItemStyle}" />
                        <Button Grid.Column="1" Width="30" Height="30" Padding="0"
                                VerticalAlignment="Top"
                                Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                                ToolTip="Zitatangabe in die Zwischenablage kopieren"
                                Command="{Binding CopyCitationCommand}">
                            <iconPacks:PackIconFontAwesome6 Kind="CopySolid" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="Links" Style="{StaticResource SectionHeadingStyle}" />
                    <views:CopyableField Margin="0,0,0,8" Label="Link auf die Kirchenbuch-Seite"
                                          IconKind="LinkSolid" Value="{Binding UrlText}"
                                          ShowExtraButton="True" ExtraCommand="{Binding OpenUrlCommand}"
                                          ExtraIconKind="ArrowUpRightFromSquareSolid" ExtraTooltip="Im Browser öffnen" />
                    <views:CopyableField Label="Link auf die Bilddatei"
                                          IconKind="ImageSolid" Value="{Binding ImageUrlText}"
                                          ShowExtraButton="True" ExtraCommand="{Binding SaveImageCommand}"
                                          ExtraIconKind="DownloadSolid" ExtraTooltip="Auf Datenträger speichern..." />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
        </TabItem>

        <!-- The Gramps-Modus view (stage 3): search + walkable tree +
             event<->source link view + change list. Opening this tab
             auto-connects to the bridge; the connection state lives in
             the status bar. -->
        <TabItem Header="Gramps" mah:HeaderedControlHelper.HeaderFontSize="16">
            <views:GrampsModeView DataContext="{Binding Gramps}" />
        </TabItem>
        </TabControl>
        </Grid>
    </Grid>
</mah:MetroWindow>
