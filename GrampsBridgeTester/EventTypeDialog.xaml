<Window x:Class="GrampsBridgeTester.EventTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ereignis vormerken"
        Width="380" Height="560" MinWidth="320" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Label Content="Beschreibung (optional):" Padding="0,0,0,2" />
            <TextBox x:Name="DescriptionBox" VerticalContentAlignment="Center"
                     Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Speichern" IsDefault="True"
                        IsEnabled="False" Padding="14,4" Margin="0,0,8,0"
                        Click="Save_Click" />
                <Button Content="Abbrechen" IsCancel="True" Padding="14,4" />
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="TypeList" DisplayMemberPath="Label"
                 SelectionChanged="TypeList_SelectionChanged"
                 MouseDoubleClick="TypeList_MouseDoubleClick"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                       Foreground="#666666" Margin="2,6,0,2" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>
    </DockPanel>
</Window>
