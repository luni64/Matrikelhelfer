<Window x:Class="GrampsBridgeTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GrampsBridgeTester"
        Title="Gramps Bridge Tester" Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,1,0,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,2,4,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,4,6,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>

        <!-- connection bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <Label Content="Discovery file:" DockPanel.Dock="Left"
                   VerticalAlignment="Center" />
            <Button Content="Connect" Command="{Binding ConnectCommand}"
                    DockPanel.Dock="Right" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                       Margin="10,0" MaxWidth="560" TextTrimming="CharacterEllipsis"
                       Text="{Binding ConnectionStatus}" FontWeight="SemiBold" />
            <TextBox Text="{Binding DiscoveryPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- person search -->
            <GroupBox Grid.Column="0" Header="1) Find person" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Surname:" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding SearchSurname, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="0" Grid.Column="2" Content="Given:" Margin="8,0,0,0" />
                        <TextBox Grid.Row="0" Grid.Column="3"
                                 Text="{Binding SearchGiven, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="1" Grid.Column="0" Content="Any name:" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding SearchQ, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="1" Grid.Column="2" Content="Place:" Margin="8,0,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="3"
                                 Text="{Binding SearchPlace, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="2" Grid.Column="0" Content="Born from:" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 Text="{Binding SearchBirthFrom, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="2" Grid.Column="2" Content="to:" Margin="8,0,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="3"
                                 Text="{Binding SearchBirthTo, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <DockPanel Grid.Row="1">
                        <Button Content="Search" Command="{Binding SearchCommand}"
                                DockPanel.Dock="Left" IsDefault="True" />
                        <TextBlock Text="{Binding SearchStatus}" VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </DockPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding Results}"
                              SelectedItem="{Binding SelectedPerson}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding PrimaryName}" Width="*" />
                            <DataGridTextColumn Header="Born" Binding="{Binding Birth.DateText}" Width="80" />
                            <DataGridTextColumn Header="Place" Binding="{Binding Birth.Place}" Width="110" />
                            <DataGridTextColumn Header="Parents" Binding="{Binding ParentsDisplay}" Width="150" />
                            <DataGridTextColumn Header="ID" Binding="{Binding GrampsId}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <!-- person detail -->
            <GroupBox Grid.Column="1" Header="2) Pick target event (optional)" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding DetailHeader}"
                               FontWeight="SemiBold" Margin="0,0,0,4"
                               TextWrapping="Wrap" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Events}"
                              SelectedItem="{Binding SelectedEvent}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="55" />
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="90" />
                            <DataGridTextColumn Header="Place" Binding="{Binding Place}" Width="*" />
                            <DataGridTextColumn Header="Cit." Binding="{Binding CitationCount}" Width="40" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2">
                        <DockPanel Margin="0,6,0,0">
                            <Label Content="Family:" DockPanel.Dock="Left"
                                   VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Families}"
                                      SelectedItem="{Binding SelectedFamily}"
                                      DisplayMemberPath="Display"
                                      ToolTip="Target family for new family events (Marriage etc.)" />
                        </DockPanel>
                        <CheckBox Margin="0,6,0,0"
                                  IsChecked="{Binding AttachToSelectedEvent}"
                                  Content="Attach citation to the selected event (otherwise a new event is created)" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- capture -->
            <GroupBox Grid.Column="2" Header="3) Capture" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Label Content="Repository name / URL:" FontWeight="SemiBold" />
                        <TextBox Text="{Binding RepoName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Text="{Binding RepoUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="Source title / author / MH_SourceKey / call number:"
                               FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBox Text="{Binding SourceTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Text="{Binding SourceAuthor, UpdateSourceTrigger=PropertyChanged}" />
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="auto"
                                      VerticalAlignment="Center" Margin="6,0,0,0"
                                      IsChecked="{Binding DeriveKey}"
                                      ToolTip="Derive the MH_SourceKey from the title (like the real app derives it from the book data). Uncheck to type a key manually, e.g. to test the mismatch warning." />
                            <TextBox Text="{Binding SourceKey, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding KeyIsManual}" />
                        </DockPanel>
                        <TextBox Text="{Binding CallNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Content="Citation page / date (yyyy-mm-dd) / confidence:"
                               FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBox Text="{Binding CitationPage, UpdateSourceTrigger=PropertyChanged}" />
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Width="110"
                                      ItemsSource="{Binding ConfidenceValues}"
                                      SelectedItem="{Binding Confidence}" />
                            <TextBox Text="{Binding CitationDate, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,1,6,3" />
                        </DockPanel>
                        <Label Content="Permalink (MH_Permalink attribute):" Margin="0,4,0,0" />
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="auto"
                                      VerticalAlignment="Center" Margin="6,0,0,0"
                                      IsChecked="{Binding DerivePermalink}"
                                      ToolTip="Derive the permalink from book key + page — in reality every scan page has its own URL. Uncheck to type one manually (e.g. to test the dedup)." />
                            <TextBox Text="{Binding Permalink, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding PermalinkIsManual}" />
                        </DockPanel>
                        <CheckBox IsChecked="{Binding CopyLinkToPersons}" Margin="0,2,0,0"
                                  Content="Copy link to Internet tab of involved persons (type Digitalisat)"
                                  ToolTip="Adds the permalink as a clickable URL on the person(s) — for family events on both partners. Deduplicated: the same link is never added twice." />
                        <Label Content="Note (transcription):" />
                        <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="48"
                                 VerticalScrollBarVisibility="Auto" />

                        <Label Content="New event (if not attaching): type / description:"
                               FontWeight="SemiBold" Margin="0,6,0,0" />
                        <ComboBox ItemsSource="{Binding EventTypes}"
                                  SelectedItem="{Binding EventType}" Margin="0,1,0,3" />
                        <TextBox Text="{Binding EventDescription, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Send to Gramps" FontWeight="Bold"
                                    Command="{Binding CaptureCommand}" />
                            <Button Content="Repeat last (same request_id)"
                                    Command="{Binding RepeatCaptureCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding CaptureStatus}" TextWrapping="Wrap"
                                   FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- log -->
        <GroupBox Grid.Row="2" Header="Raw JSON log (newest first)" Padding="4"
                  Margin="0,6,0,0">
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </GroupBox>
    </Grid>
</Window>
