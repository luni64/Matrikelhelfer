<Window x:Class="GrampsBridgeTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GrampsBridgeTester"
        Title="Gramps Bridge Tester — Gramps-Modus Prototyp"
        Width="1400" Height="880" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,1,0,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,2,4,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,4,6,4" />
        </Style>

        <!-- one tree box; identity-stable, updated in place.
             Fixed widths (no content-driven sizing); whole box clicks. -->
        <DataTemplate x:Key="PersonBox" DataType="{x:Type local:PersonBoxVM}">
            <Border x:Name="Box" Margin="5,4" Padding="8,5" CornerRadius="10"
                    Background="#FDFDFD" BorderBrush="#8C8C8C" BorderThickness="1.3"
                    Width="132" Height="70" Cursor="Hand"
                    ToolTip="{Binding ToolTipText}"
                    AllowDrop="True" DragOver="PersonBox_DragOver"
                    Drop="PersonBox_Drop">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding DataContext.NavigateCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="NameLine" Text="{Binding Name}"
                               FontWeight="Bold" FontSize="12" Foreground="#333333"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                    <TextBlock x:Name="BirthLine" Text="{Binding BirthText}"
                               FontSize="10.5" Foreground="#555555"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                    <TextBlock x:Name="DeathLine" Text="{Binding DeathText}"
                               FontSize="10.5" Foreground="#555555"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                    <TextBlock x:Name="BadgeLine" Text="{Binding Badges}"
                               FontSize="9.5" Foreground="#B36B00"
                               TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLarge}" Value="True">
                    <Setter TargetName="Box" Property="Width" Value="198" />
                    <Setter TargetName="Box" Property="Height" Value="96" />
                    <Setter TargetName="NameLine" Property="FontSize" Value="15" />
                    <Setter TargetName="BirthLine" Property="FontSize" Value="12" />
                    <Setter TargetName="DeathLine" Property="FontSize" Value="12" />
                    <Setter TargetName="BadgeLine" Property="FontSize" Value="10.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCenter}" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="#1440C8" />
                    <Setter TargetName="Box" Property="BorderThickness" Value="2.4" />
                    <Setter TargetName="NameLine" Property="Foreground" Value="#1440C8" />
                    <Setter TargetName="BirthLine" Property="Foreground" Value="#1440C8" />
                    <Setter TargetName="DeathLine" Property="Foreground" Value="#1440C8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="#C8C8C8" />
                    <Setter TargetName="Box" Property="Background" Value="#FBFBFB" />
                    <Setter TargetName="Box" Property="Cursor" Value="Arrow" />
                    <Setter TargetName="Box" Property="ToolTip" Value="{x:Null}" />
                    <Setter TargetName="NameLine" Property="Foreground" Value="#A0A0A0" />
                    <Setter TargetName="BirthLine" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="DeathLine" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BadgeLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- interlocked rings between the partners of a couple -->
        <Style x:Key="Rings" TargetType="TextBlock">
            <Setter Property="Text" Value="⚭" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="-2,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>

        <!-- connection -->
        <DockPanel Grid.Row="0" Margin="0,0,0,4">
            <Label Content="Discovery:" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <Button Content="Connect" Command="{Binding ConnectCommand}"
                    DockPanel.Dock="Right" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0"
                       MaxWidth="620" TextTrimming="CharacterEllipsis"
                       Text="{Binding ConnectionStatus}" FontWeight="SemiBold" />
            <TextBox Text="{Binding DiscoveryPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" />
        </DockPanel>

        <!-- search -->
        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <Label Content="Suche:" DockPanel.Dock="Left" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding SearchStatus}"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
            <ComboBox DockPanel.Dock="Right" Width="380" Margin="8,0,0,0"
                      ItemsSource="{Binding SearchResults}"
                      SelectedItem="{Binding SelectedResult}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding PrimaryName, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="{Binding Birth.DateText, Mode=OneWay}" />
                            <Run Text="{Binding Birth.Place, Mode=OneWay}" Foreground="Gray" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Suchen" Command="{Binding SearchCommand}"
                    DockPanel.Dock="Right" IsDefault="True" />
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"
                     ToolTip="Name und ungefähres Geburtsjahr, z. B.: Meier 1780" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <!-- tree + facts -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1"
                            CornerRadius="8" Padding="10,10">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- parents inner-aligned over the couple: the
                                 groom's mother's right edge meets the groom's
                                 right edge; mirrored for the bride -->
                            <Grid x:Name="TreeGrid" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <ContentControl Content="{Binding LeftParentsRow[0]}"
                                                    ContentTemplate="{StaticResource PersonBox}" />
                                    <TextBlock Style="{StaticResource Rings}" />
                                    <ContentControl Content="{Binding LeftParentsRow[1]}"
                                                    ContentTemplate="{StaticResource PersonBox}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <ContentControl Content="{Binding RightParentsRow[0]}"
                                                    ContentTemplate="{StaticResource PersonBox}" />
                                    <TextBlock Style="{StaticResource Rings}" />
                                    <ContentControl Content="{Binding RightParentsRow[1]}"
                                                    ContentTemplate="{StaticResource PersonBox}" />
                                </StackPanel>

                                <!-- couple: man left, woman right; blue = selected -->
                                <ContentControl Grid.Row="1" Grid.Column="0"
                                                Content="{Binding LeftBox}"
                                                ContentTemplate="{StaticResource PersonBox}"
                                                HorizontalAlignment="Right" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource Rings}" Margin="-2,6,-2,0" />
                                <ContentControl Grid.Row="1" Grid.Column="2"
                                                Content="{Binding RightBox}"
                                                ContentTemplate="{StaticResource PersonBox}"
                                                HorizontalAlignment="Left" Margin="0,6,0,0" />
                            </Grid>

                            <ComboBox Width="230" HorizontalAlignment="Center" Margin="0,4,0,0"
                                      ItemsSource="{Binding Families}"
                                      SelectedItem="{Binding SelectedFamily}"
                                      DisplayMemberPath="Display"
                                      ToolTip="Familie wählen (bei mehreren Ehen)"
                                      Visibility="{Binding HasMultipleFamilies,
                                                   Converter={StaticResource BoolToVisibility}}" />

                            <!-- children: same width as the rows above, no band -->
                            <ScrollViewer Width="{Binding ActualWidth, ElementName=TreeGrid}"
                                          HorizontalAlignment="Center" Margin="0,8,0,0"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ChildrenRow}"
                                              ItemTemplate="{StaticResource PersonBox}"
                                              ItemsPanel="{StaticResource HorizontalPanel}"
                                              HorizontalAlignment="Left" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <GroupBox Header="Fakten und Ereignisse (Person im Zentrum) — 📎 markiert Ziele"
                              Padding="6" Margin="0,8,0,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Facts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:FactRowVM}">
                                        <Border x:Name="FactRow" CornerRadius="3" Padding="2,1"
                                                Background="Transparent"
                                                AllowDrop="True"
                                                DragOver="FactRow_DragOver"
                                                Drop="FactRow_Drop">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Left" Content="📎"
                                                        Width="28" FontSize="11" Margin="0" Padding="0"
                                                        Command="{Binding DataContext.ToggleFactCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Fund diesem Ereignis zuordnen (wie Karte darauf ziehen)" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding Badges}" Foreground="#B36B00"
                                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                                                <TextBlock DockPanel.Dock="Right" Foreground="Gray"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Text="{Binding CitationCount, StringFormat='Zit. {0}'}" />
                                                <TextBlock x:Name="FactLabel" Text="{Binding Label}"
                                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPendingNew}" Value="True">
                                                <Setter TargetName="FactRow" Property="Background"
                                                        Value="#EAF3FF" />
                                                <Setter TargetName="FactLabel" Property="FontStyle"
                                                        Value="Italic" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Left" Content="+ Ereignis vormerken"
                                        Margin="0,0,6,0" Command="{Binding AddEventCommand}"
                                        ToolTip="Erzeugt einen Eintrag in der Änderungsliste und eine (neu)-Zeile oben — auch die ist ein Ablageziel für die Zitatkarte" />
                                <ComboBox Width="130" Margin="0,0,6,0"
                                          ItemsSource="{Binding EventTypes}"
                                          SelectedItem="{Binding EventType}" />
                                <TextBox Text="{Binding EventDescription, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         ToolTip="Beschreibung des neuen Ereignisses" />
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- find + queue -->
            <DockPanel Grid.Column="1">
                <GroupBox DockPanel.Dock="Top" Header="Aktueller Fund (im echten Client: gescrapte Daten)"
                          Padding="6">
                    <StackPanel>
                        <TextBox Text="{Binding SourceTitle, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Quellentitel (Kirchenbuch)" />
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="auto"
                                      VerticalAlignment="Center" Margin="6,0,0,0"
                                      IsChecked="{Binding DeriveKey}" />
                            <TextBox Text="{Binding SourceKey, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding KeyIsManual}" ToolTip="MH_SourceKey" />
                        </DockPanel>
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Width="100"
                                      ItemsSource="{Binding ConfidenceValues}"
                                      SelectedItem="{Binding Confidence}" />
                            <TextBox Text="{Binding CitationDate, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,1,6,3" ToolTip="Datum des Eintrags (yyyy-mm-dd)" />
                        </DockPanel>
                        <TextBox Text="{Binding CitationPage, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Seite / Eintrag" />
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="auto"
                                      VerticalAlignment="Center" Margin="6,0,0,0"
                                      IsChecked="{Binding DerivePermalink}" />
                            <TextBox Text="{Binding Permalink, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding PermalinkIsManual}" ToolTip="Permalink" />
                        </DockPanel>
                        <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="40"
                                 VerticalScrollBarVisibility="Auto" ToolTip="Notiz/Transkription" />
                        <CheckBox IsChecked="{Binding CopyLinkToPersons}"
                                  Content="Link in Internet-Reiter der Beteiligten" />
                    </StackPanel>
                </GroupBox>

                <!-- the draggable citation card (mockup bottom-left) -->
                <Border DockPanel.Dock="Top" x:Name="CitationCard"
                        Background="White" BorderBrush="#B0B0B0" BorderThickness="1"
                        CornerRadius="4" Padding="10,6" Margin="0,6,0,0"
                        Cursor="SizeAll"
                        PreviewMouseLeftButtonDown="CitationCard_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="CitationCard_PreviewMouseMove">
                    <StackPanel>
                        <TextBlock Text="Quelle" FontSize="9.5" Foreground="Gray" />
                        <TextBlock Text="{Binding SourceTitle}" TextWrapping="Wrap"
                                   FontSize="12.5" />
                        <TextBlock Text="{Binding CallNumber, StringFormat='Signatur: {0}'}"
                                   FontSize="12.5" />
                        <TextBlock Text="Zitat (neu)" FontSize="9.5" Foreground="Gray"
                                   Margin="0,4,0,0" />
                        <DockPanel>
                            <TextBlock Text="{Binding CitationPage}" FontSize="12.5" />
                            <TextBlock Text="{Binding CitationDate}" Foreground="Gray"
                                       FontSize="12.5" Margin="8,0,0,0" />
                        </DockPanel>
                        <TextBlock Text="⇖  Karte auf Person oder Ereignis ziehen — jede Ablage wird ein Eintrag in der Änderungsliste"
                                   FontSize="10" Foreground="#888888" TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="{Binding QueueStatus}"
                           TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0" />

                <Button DockPanel.Dock="Bottom" Content="An Gramps senden" FontWeight="Bold"
                        FontSize="14" Command="{Binding SendCommand}" Margin="0,6,0,0" />

                <GroupBox Header="Änderungsliste (lokal — Löschen macht rückgängig, Upload führt aus)"
                          Padding="4" Margin="0,6,0,0">
                    <TreeView ItemsSource="{Binding ChangeTree}" BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:ChangeGroupVM}"
                                                      ItemsSource="{Binding Children}">
                                <DockPanel Margin="0,1">
                                    <Button DockPanel.Dock="Right" Content="🗑" Padding="3,0"
                                            Margin="6,0,0,0" FontSize="11"
                                            ToolTip="Alle Änderungen zu dieser Person/Familie entfernen"
                                            Command="{Binding DataContext.DeleteGroupCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding EntityLabel}" FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:ChangeNodeVM}"
                                                      ItemsSource="{Binding Children}">
                                <DockPanel Margin="0,1">
                                    <Button DockPanel.Dock="Right" Content="🗑" Padding="3,0"
                                            Margin="6,0,0,0" FontSize="10"
                                            ToolTip="Diese Änderung entfernen (abhängige werden mit entfernt)"
                                            Command="{Binding DataContext.DeleteEntryCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Entry}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Entry.DisplayText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Entry.Error}" Foreground="#C00000"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Visibility="{Binding Entry.HasError,
                                                                Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </GroupBox>
            </DockPanel>
        </Grid>

        <!-- log -->
        <GroupBox Grid.Row="3" Header="Raw JSON log (newest first)" Padding="4" Margin="0,6,0,0">
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
        </GroupBox>
    </Grid>
</Window>
